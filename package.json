{
  "name": "clipsurgeon",
  "version": "0.5.0",
  "description": "AI video editor - prompt-based editing with human review, timeline adjustment, version history, karaoke captions, music",
  "author": "edit.ai",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/engine.test.js test/engine-m1.test.js test/engine-m2.test.js test/engine-m3.test.js",
    "bench": "node bench/editbench.js",
    "setup-whisper": "node scripts/setup-whisper.js",
    "setup-whisper-gpu": "node scripts/setup-whisper.js --gpu",
    "setup-upscaler": "node scripts/setup-upscaler.js",
    "shorts": "node scripts/make-shorts.js",
    "thumbnails": "node scripts/make-thumbnails.js",
    "edit-report": "node scripts/export-edit-report.js",
    "electron": "electron electron/main.js",
    "dist": "electron-builder --win",
    "dist:zip": "electron-builder --win zip",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@xenova/transformers": "^2.17.2",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ai.edit.desktop",
    "productName": "edit.ai",
    "asar": false,
    "extraMetadata": { "main": "electron/main.js" },
    "files": [
      "server.js",
      "electron/**",
      "lib/**",
      "scripts/**",
      "public/**",
      ".env.example",
      "node_modules/**",
      "!web/**",
      "!bench/**",
      "!test/**",
      "!**/*.map",
      "!**/*.ts",
      "!uploads/**",
      "!outputs/**",
      "!.models/**",
      "!bin/**",
      "!models/**",
      "!dist/**"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "edit.ai"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
